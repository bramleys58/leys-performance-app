# Copy this file to .env.local for local development.
# On Vercel, add the same two names under Project Settings > Environment Variables.
# Both values are on the Supabase project page: Project Settings > API (or the Connect button).
# They are safe to expose in the browser: access is protected by the database rules.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
